{
  "schemaVersion": 1,
  "id": "sccosmetics",
  "version": "${version}",
  "name": "SC Client Cosmetics",
  "description": "Shows the hats, capes, wings and cape elytras picked in the SC Client Wardrobe, on you and on other SC Client players.",
  "authors": ["baksya", "wsammyyy"],
  "license": "GPL-3.0-only",
  "icon": "assets/sccosmetics/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.chromeclient.ScCosmetics"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "breaks": {
    "chromeclient": "*"
  },
  "mixins": ["sccosmetics.mixins.json"]
}
