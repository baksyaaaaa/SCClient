# Maintainer: SC <contact@atmofrost.org>
pkgname=scclient
pkgver=2.0.1
pkgrel=1
pkgdesc="Next-generation open source Minecraft launcher (built from source)"
arch=('x86_64')
url="https://github.com/baksyaaaaa/SCClient"
license=('GPL-3.0-only')
depends=(
  'fontconfig'
  'freetype2'
  'libglvnd'
  'libxcursor'
  'libxrandr'
  'libxi'
  'libxkbcommon'
  'wayland'
  'dbus'
)
makedepends=(
  'rust'
  'cargo'
  'cmake'
  'clang'
  'pkgconf'
  'python'
)
provides=('scclient')
conflicts=('scclient-bin')
options=(
  '!lto'
  '!debug'
)
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/scclient-${pkgver}.tar.gz")
sha256sums=('SKIP')

_srcdir="SCLauncher-scclient-${pkgver}"

prepare() {
  cd "$srcdir/$_srcdir"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$_srcdir"
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen --bin scclient_app
}

package() {
  cd "$srcdir/$_srcdir"
  local appdir="packages/scclient_app"

  install -Dm755 "target/release/scclient_app" "$pkgdir/usr/bin/scclient_app"
  ln -s scclient_app "$pkgdir/usr/bin/scclient"

  install -dm755 "$pkgdir/usr/share/applications"
  sed -e 's|{{exec}}|scclient_app|g' \
      -e 's|{{icon}}|org.sc.SCClient|g' \
      "$appdir/distribution/linux/org.sc.scclient.template" \
      > "$pkgdir/usr/share/applications/org.sc.SCClient.desktop"

  install -Dm644 "$appdir/icons/32x32.png"    "$pkgdir/usr/share/icons/hicolor/32x32/apps/org.sc.SCClient.png"
  install -Dm644 "$appdir/icons/128x128.png"  "$pkgdir/usr/share/icons/hicolor/128x128/apps/org.sc.SCClient.png"
  install -Dm644 "$appdir/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/org.sc.SCClient.png"
  install -Dm644 "$appdir/icons/512x512.png"  "$pkgdir/usr/share/icons/hicolor/512x512/apps/org.sc.SCClient.png"
}
